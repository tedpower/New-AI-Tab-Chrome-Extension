{
  "manifest_version": 3,
  "name": "Tabula Rasa",
  "version": "1.0",
  "description": "Put minimalist chat on your new tab page.",
  "icons": {
    "128": "icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["scripts/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.openai.com/*"],
      "js": ["scripts/chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["scripts/gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://meta.ai/*"],
      "js": ["scripts/meta.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://grok.x.ai/*"],
      "js": ["scripts/grok.js"],
      "run_at": "document_idle"
    }
  ]
}
